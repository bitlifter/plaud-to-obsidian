# Path to your Obsidian vault (absolute path)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian-vault

# Optional: Pre-seed your company and known clients (comma-separated).
# The pipeline also automatically learns new organizations dynamically and saves them locally to ~/.plaud/known_organizations.json
# KNOWN_ORGANIZATIONS="Acme Corp, Initech, Globex"

# Optional: Set an API key if you want Cloud LLM fallback when offline heuristic confidence is low (< 0.70)
GEMINI_API_KEY=your_google_ai_studio_api_key
# OPENAI_API_KEY=your_openai_api_key

